# Copier en .env (ignoré par Git) et renseigner les valeurs.
# API Mock, URL obligatoire (aucune valeur par défaut dans le code) :
# - publique, avec authentification (à privilégier) : https://api-mock.charlieandre.fr
# - interne au réseau de l'école, sans authentification : http://10.43.43.80:8000
MOCK_API_URL=https://api-mock.charlieandre.fr
MOCK_API_USERNAME=
MOCK_API_PASSWORD=

# Base de données locale (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=enervision
POSTGRES_PORT=5432

# API locale (docker-compose.yml)
API_PORT=8000
# Clé de signature des jetons JWT, obligatoire : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Limites de /auth/login (échecs sur une fenêtre glissante, en secondes) : 429 avec Retry-After au-delà.
# Valeurs par défaut de l'API, à décommenter pour les changer.
# LOGIN_IP_MAX_FAILURES=10
# LOGIN_IP_WINDOW_SECONDS=900
# LOGIN_ACCOUNT_MAX_FAILURES=5
# LOGIN_ACCOUNT_WINDOW_SECONDS=900
# Environnement affiché par l'API (/health et /docs) : dev en local, staging et production sur les serveurs
APP_ENV=dev

# ETL local (docker-compose.yml)
ETL_PORT=8001
# Secondes entre deux tours du collecteur (python -m pipeline poll-current)
POLL_INTERVAL_SECONDS=60

# Frontend local (docker-compose.yml)
FRONTEND_PORT=4000

# Test de charge k6 (docker compose --profile load run --rm k6, voir infra/k6/)
# Compte de test dédié (admin, ou user rattaché à un site), jamais un vrai compte. Cible : l'API du compose
# par défaut ; le script refuse une API de production.
# *** NE PAS RENSEIGNER CES CHAMPS SAUF POUR TESTER EN LOCAL ***
# K6_EMAIL=
# K6_PASSWORD=
# K6_BASE_URL=http://api:8000

# Serveur MLflow local (docker-compose.yml)
MLFLOW_PORT=5000

# Supervision (docker-compose.monitoring.yml)
# Mot de passe de l'administrateur Grafana, obligatoire : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=
# Facultatif : URL du webhook d'un workflow Teams, où Alertmanager envoie les alertes (vide : aucun envoi)
TEAMS_WEBHOOK_URL=
# Facultatif : jeton GitHub en lecture seule pour le dashboard « CI et livraisons » de Grafana (monitoring/README.md)
GRAFANA_GITHUB_TOKEN=
