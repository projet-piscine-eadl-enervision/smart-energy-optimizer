# Copier en .env (ignoré par Git) et renseigner les valeurs.
# API Mock, URL obligatoire (aucune valeur par défaut dans le code) :
# - publique, avec authentification (à privilégier) : https://api-mock.charlieandre.fr
# - interne au réseau de l'école, sans authentification : http://10.43.43.80:8000
MOCK_API_URL=https://api-mock.charlieandre.fr
MOCK_API_USERNAME=
MOCK_API_PASSWORD=

# Base de données locale (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=enervision
POSTGRES_PORT=5432

# API locale (docker-compose.yml)
API_PORT=8000
# Clé de signature des jetons JWT, obligatoire : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Environnement affiché par l'API (/health et /docs) : dev en local, staging et production sur les serveurs
APP_ENV=dev

# ETL local (docker-compose.yml)
ETL_PORT=8001
# Secondes entre deux tours du collecteur (python -m pipeline poll-current)
POLL_INTERVAL_SECONDS=60

# Frontend local (docker-compose.yml)
FRONTEND_PORT=4000

# Serveur MLflow local (docker-compose.yml)
MLFLOW_PORT=5000
