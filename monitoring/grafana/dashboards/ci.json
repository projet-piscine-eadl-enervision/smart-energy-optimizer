    {
      "id": 1,
      "type": "stat",
      "title": "Dernier run de CI sur main",
      "description": "Conclusion du dernier run de ci.yml sur main (publication des images comprise).",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "github"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "github"
          },
          "queryType": "Workflow_Runs",
          "owner": "projet-piscine-eadl-enervision",
          "repository": "smart-energy-optimizer",
          "options": {
            "workflow": "ci.yml",
            "branch": "main"
          }
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "created_at",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 1
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "success": {
                  "text": "Succès",
                  "color": "green",
                  "index": 0
                },
                "failure": {
                  "text": "Échec",
                  "color": "red",
                  "index": 1
                },
                "cancelled": {
                  "text": "Annulé",
                  "color": "text",
                  "index": 2
                },
                "skipped": {
                  "text": "Ignoré",
                  "color": "text",
                  "index": 3
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "En cours",
                  "color": "blue",
                  "index": 10
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "empty",
                "result": {
                  "text": "En cours",
                  "color": "blue",
                  "index": 11
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^conclusion$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
