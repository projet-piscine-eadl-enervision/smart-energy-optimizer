      "targets": [
        {
          "dataset": "enervision",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb-ml"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.model_version AS \"Version\", r.model AS \"Modèle\", r.trained_at AS \"Entraîné le\",\r\n       r.is_champion AS \"Champion\",\r\n       max(m.value) FILTER (WHERE m.metric = 'val_nmae') AS \"nMAE validation\",\r\n       max(m.value) FILTER (WHERE m.metric = 'test_nmae_gain_vs_naive') AS \"Gain vs naïf\",\r\n       r.decision AS \"Décision\"\r\nFROM ml.model_run r LEFT JOIN ml.model_metric m USING (model_version)\r\nGROUP BY r.model_version, r.model, r.trained_at, r.is_champion, r.decision\r\nORDER BY r.trained_at DESC\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
